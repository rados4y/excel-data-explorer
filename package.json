{
  "name": "excel-data-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "node scripts/run.mjs tauri dev --features desktop",
    "desktop:build": "node scripts/run.mjs tauri build --features desktop,custom-protocol",
    "demo": "node fixtures/generate.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:core": "node scripts/run.mjs cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "check": "tsc -b",
    "format": "prettier --write src tests scripts fixtures/*.mjs *.json *.ts *.html",
    "lint": "tsc -b",
    "format:check": "prettier --check src tests scripts fixtures/*.mjs *.json *.ts *.html",
    "core:build": "node scripts/run.mjs cargo build --manifest-path src-tauri/Cargo.toml --no-default-features",
    "lint:core": "node scripts/run.mjs cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --no-default-features -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tanstack/react-table": "^8",
    "@tanstack/react-virtual": "^3",
    "react": "^19",
    "react-dom": "^19",
    "lucide-react": "^0.468"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/node": "^24",
    "@vitejs/plugin-react": "^5",
    "vite": "^7",
    "typescript": "^5.9",
    "vitest": "^3",
    "@playwright/test": "^1.56",
    "prettier": "^3"
  }
}
